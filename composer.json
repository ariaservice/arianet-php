{
    "name": "ariaservice/arianet",
    "description": "Official PHP client for the Arianet (Ariaservice) public API",
    "type": "library",
    "license": "MIT",
    "keywords": ["arianet", "ariaservice", "cloud", "vps", "hosting", "sms", "api", "sdk"],
    "homepage": "https://github.com/ariaservice/arianet-php",
    "support": {
        "issues": "https://github.com/ariaservice/arianet-php/issues",
        "docs": "https://docs.ariaservice.net/sdk/php",
        "source": "https://github.com/ariaservice/arianet-php"
    },
    "authors": [{ "name": "Ariaservice", "email": "git@ariaservice.net" }],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": { "Arianet\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Arianet\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
